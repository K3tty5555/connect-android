{
  "name": "@connect/mobile",
  "version": "1.0.17",
  "main": "index.ts",
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.13",
    "@lobehub/icons-rn": "^2.12.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "^8.20.0",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "nanoid": "3.3.18",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "room:build": "node ../../scripts/build-mobile-room.mjs",
    "room:check": "node ../../scripts/build-mobile-room.mjs --check",
    "terminal:build": "npm run assets:check",
    "icons:build": "node ../../scripts/build-mobile-file-icons.mjs",
    "icons:check": "node ../../scripts/build-mobile-file-icons.mjs --check",
    "assets:check": "npm run room:check && npm run icons:check",
    "prestart": "npm run assets:check",
    "start": "expo start",
    "preios": "npm run assets:check",
    "ios": "expo run:ios",
    "preandroid": "npm run assets:check",
    "android": "expo run:android",
    "prebuild:ios-store": "expo prebuild --platform ios --no-install",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "preexport:ios": "npm run assets:check",
    "export:ios": "expo export --platform ios --output-dir dist/ios --clear",
    "preexport:android": "npm run assets:check",
    "export:android": "expo export --platform android --output-dir dist/android --clear",
    "doctor": "npx expo-doctor@latest"
  },
  "private": true
}
